# ---------------------------------------------------------------------------
# TransitSpotter environment configuration
# Copy this file to `.env.local` and fill in the values from your Supabase
# project dashboard (Project Settings -> API).
# ---------------------------------------------------------------------------

# Public Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The public "publishable" (or legacy "anon") key. Safe to expose to the
# browser: all access is governed by Row Level Security policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. The secret / service_role key is used exclusively by the
# migration + seed scripts. Never prefix this with NEXT_PUBLIC_ and never
# import it into client code.
SUPABASE_SERVICE_ROLE_KEY=

# The public origin used in authentication email redirects. For local
# development use http://localhost:3000. In production use your Vercel domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Supabase Storage bucket name (created by the migration).
NEXT_PUBLIC_SUPABASE_PHOTO_BUCKET=transitspotter-photos

# Optional: maximum upload size in megabytes (must not exceed the bucket limit).
NEXT_PUBLIC_MAX_UPLOAD_MB=15

# ---------------------------------------------------------------------------
# Development / verification only (never production secrets)
# ---------------------------------------------------------------------------
# Account used by `pnpm seed`, `pnpm smoke` and the RLS verification script.
DEMO_EMAIL=
DEMO_PASSWORD=
SMOKE_EMAIL=
SMOKE_PASSWORD=
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
